generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  normalizedSku  String
  productNumber  String   @default("")
  description    String   @default("")
  vendor         String   @default("")
  brand          String   @default("")
  listCost       Decimal  @db.Decimal(12, 2) @default(0)
  price          Decimal  @db.Decimal(12, 2) @default(0)
  sizeDesc              String   @default("")
  isInactive            Boolean  @default(false)
  isOldSku              Boolean  @default(false)
  supersededByProductId String?
  supersededByProduct   Product?  @relation("ProductSupersededBy", fields: [supersededByProductId], references: [id], onDelete: SetNull)
  supersededProducts    Product[] @relation("ProductSupersededBy")
  previousSkuProductId  String?
  previousSkuProduct    Product?  @relation("ProductPreviousSku", fields: [previousSkuProductId], references: [id], onDelete: SetNull)
  nextSkuProducts       Product[] @relation("ProductPreviousSku")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  priceItems PriceUpdateItem[]

  @@index([normalizedSku])
  @@index([vendor])
  @@index([brand])
  @@index([isInactive])
  @@index([isOldSku])
  @@index([supersededByProductId])
  @@index([previousSkuProductId])
}

model VendorDiscount {
  id               String   @id @default(cuid())
  vendor           String
  normalizedVendor String   @unique
  defaultDiscount  Decimal  @db.Decimal(6, 2) @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BrandDiscount {
  id                String   @id @default(cuid())
  brand             String
  normalizedBrand   String
  vendor            String   @default("")
  normalizedVendor  String   @default("")
  defaultDiscount   Decimal  @db.Decimal(6, 2) @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([normalizedVendor, normalizedBrand])
  @@index([normalizedVendor])
  @@index([normalizedBrand])
}

model PriceUpdateSession {
  id                     String    @id @default(cuid())
  vendor                 String    @default("")
  name                   String
  status                 String    @default("Draft")
  notes                  String    @default("")
  createdBy              String    @default("")
  scheduledEffectiveDate DateTime? @db.Date
  scheduledAt            DateTime?
  scheduledBy            String?
  previousStatus         String?
  scheduleStatus         String?
  scheduleCancelledAt    DateTime?
  scheduleCancelledBy    String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  items           PriceUpdateItem[]
  exports         ExportLog[]
  reminders       PriceUpdateReminder[]
  scheduleHistory PriceUpdateScheduleHistory[]

  @@index([vendor])
  @@index([status])
  @@index([scheduledEffectiveDate])
  @@index([scheduleStatus])
}

model PriceUpdateReminder {
  id                     String             @id @default(cuid())
  sessionId              String
  session                PriceUpdateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reminderType           String
  scheduledReminderAt    DateTime
  customRecipientsJson   String?            @db.Text
  resolvedRecipientsJson String?            @db.Text
  status                 String             @default("SCHEDULED")
  processingStartedAt    DateTime?
  sentAt                 DateTime?
  attemptedAt            DateTime?
  attemptCount           Int                @default(0)
  maxAttempts            Int                @default(3)
  nextRetryAt            DateTime?
  lastError              String?            @db.Text
  providerRequestId      String?
  providerEmailId        String?
  createdBy              String             @default("")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([sessionId])
  @@index([status, scheduledReminderAt])
  @@index([status, nextRetryAt])
}

model PriceUpdateScheduleHistory {
  id                    String             @id @default(cuid())
  sessionId             String
  session               PriceUpdateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  action                String
  previousEffectiveDate DateTime?          @db.Date
  newEffectiveDate      DateTime?          @db.Date
  performedBy           String             @default("")
  detail                String             @default("") @db.Text
  createdAt             DateTime           @default(now())

  @@index([sessionId, createdAt])
}

model PriceUpdateItem {
  id                 String   @id @default(cuid())
  sessionId          String
  session            PriceUpdateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawVendorSku       String   @default("")
  cleanedSku         String   @default("")
  cleanedOverridden  Boolean  @default(false)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNumber      String   @default("")
  productName        String   @default("")
  brand              String   @default("")
  vendor             String   @default("")
  discount           Decimal? @db.Decimal(6, 2)
  currentListPrice   Decimal? @db.Decimal(12, 2)
  vendorListPriceNew Decimal? @db.Decimal(12, 2)
  ourNewListPrice    Decimal? @db.Decimal(12, 2)
  marginDivisor      Decimal? @db.Decimal(10, 4)
  ourNewRetailPrice  Decimal? @db.Decimal(12, 4)
  oldRetailPrice     Decimal? @db.Decimal(12, 2)
  nearest9           Decimal? @db.Decimal(12, 2)
  /// User's manually entered (custom) Nearest 9. NULL = use the calculated value.
  /// `nearest9` above always holds the FINAL value (custom when present, else calculated).
  nearest9Custom     Decimal? @db.Decimal(12, 2)
  notes              String   @default("")
  isInactive         Boolean  @default(false)
  matched            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sessionId])
  @@index([cleanedSku])
  @@index([matched])
}

model AppUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model ExportLog {
  id        String   @id @default(cuid())
  sessionId String
  session   PriceUpdateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String
  createdBy String   @default("")
  createdAt DateTime @default(now())
  detail    String   @default("")
}

model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Price99Batch {
  id           String   @id @default(cuid())
  batchId      String   @unique
  action       String   // "CHECK" | "UNCHECK"
  productCount Int
  itemsJson    String   @db.Text
  createdBy    String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model AdHocCountSheet {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("In Progress")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     AdHocCountItem[]

  @@index([status])
  @@index([createdAt])
}

model AdHocCountItem {
  id          String   @id @default(cuid())
  sheetId     String
  sheet       AdHocCountSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  orderIndex  Int      @default(0)
  sku         String   @default("")
  brand       String   @default("")
  description String   @default("")
  sizeDesc    String   @default("")
  matched     Boolean  @default(false)
  qqh         String   @default("")
  layway      String   @default("")
  prepaid     String   @default("")
  expiry      String   @default("")
  onTransfer  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sheetId])
  @@index([orderIndex])
}

model HelpCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  icon        String        @default("book")
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  articles    HelpArticle[]

  @@index([sortOrder])
}

model HelpArticle {
  id                    String                @id @default(cuid())
  categoryId            String
  category              HelpCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug                  String                @unique
  status                String                @default("DRAFT") // "DRAFT" | "PUBLISHED"
  draftTitle            String
  draftSummary          String                @default("")
  draftContentJson      String                @db.Text
  publishedTitle        String?
  publishedSummary      String?
  publishedContentJson  String?               @db.Text
  hasUnpublishedChanges Boolean               @default(false)
  relatedSlugsJson      String                @default("[]") @db.Text
  contextKeysJson       String                @default("[]") @db.Text
  needsReview           Boolean               @default(false)
  sortOrder             Int                   @default(0)
  authorEmail           String                @default("")
  updatedByEmail        String                @default("")
  publishedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  revisions             HelpArticleRevision[]

  @@index([categoryId, sortOrder])
  @@index([status])
}

model HelpArticleRevision {
  id          String      @id @default(cuid())
  articleId   String
  article     HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  summary     String      @default("")
  contentJson String      @db.Text
  eventType   String      @default("DRAFT_SAVED")
  editorEmail String      @default("")
  note        String      @default("")
  createdAt   DateTime    @default(now())

  @@index([articleId, version])
}

model HelpImage {
  id              String   @id @default(cuid())
  filename        String
  mimeType        String
  sizeBytes       Int
  storageProvider String   @default("database") // "supabase" | "database" | "local"
  storagePath     String?
  data            Bytes?
  altText         String   @default("")
  caption         String   @default("")
  uploadedBy      String   @default("")
  createdAt       DateTime @default(now())

  @@index([createdAt])
}



