# Copy to .env.local for development. Never commit real secrets.
#
# VERCEL / PRODUCTION (Supabase): set BOTH of these in the Vercel dashboard
# (Project Settings -> Environment Variables), Production + Preview + Development.
#
#   DATABASE_URL = the Supavisor TRANSACTION POOLER connection string
#   (Supabase Dashboard -> Project Settings -> Database -> Connection string ->
#   "Transaction pooler", port 6543, ends with ?pgbouncer=true). Example shape:
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Do NOT use the direct db.<ref>.supabase.co:5432 URL here — serverless
#   functions on Vercel usually can't reach it (Prisma P1001).
#
#   AUTH_SECRET = a long random string (min 32 chars). Generate with:
#     openssl rand -base64 48
#
# MIGRATIONS / SEED from your own machine use the DIRECT (port 5432) URL:
#   DATABASE_URL="postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres" npm run prisma:deploy
#   DATABASE_URL="postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres" ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='<strong-password>' npm run seed
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Only used by `npm run seed` when DATABASE_URL is set (production Postgres seed).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# =============================================================================
# Price Update Calendar & Automated Email Reminders (SMTP2GO + Vercel Cron)
# =============================================================================
# Server-side ONLY — NEVER prefix with NEXT_PUBLIC_ and never commit real values.
#
# SMTP2GO_API_KEY: API key from SMTP2GO Dashboard -> Sending -> API Keys.
# SMTP2GO_FROM_EMAIL: Must belong to a verified sender domain (SPF/DKIM CNAMEs)
#   or single verified sender in SMTP2GO -> Sending -> Verified Senders.
# SMTP2GO_FROM_NAME: Display name shown in the From header (e.g. "Genesis Nutrition").
# APP_BASE_URL: Full deployed app URL used for secure links in reminder emails
#   (e.g. https://pricing.yourdomain.com). Falls back to VERCEL_PROJECT_PRODUCTION_URL.
# CRON_SECRET: Random 32+ char secret (e.g. `openssl rand -hex 32`) configured in
#   Vercel Environment Variables; Vercel sends `Authorization: Bearer <CRON_SECRET>`.
# REMINDER_EMAILS_ENABLED: Set to "true" ONLY after testing email delivery to
#   activate automated production cron reminder sending.
SMTP2GO_API_KEY=""
SMTP2GO_FROM_EMAIL=""
SMTP2GO_FROM_NAME="Genesis Nutrition"
APP_BASE_URL=""
CRON_SECRET=""
REMINDER_EMAILS_ENABLED="false"

# =============================================================================
# Help Centre / Knowledge Base Administration & Optional Screenshot Storage
# =============================================================================
# HELP_ADMIN_EMAILS: Optional comma-separated allowlist of user emails allowed
#   to create, edit, delete, upload images, and publish Help Centre articles.
#   When unset, the existing AppUser "admin" role is used automatically.
# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional Supabase Storage credentials
#   for storing uploaded Help Centre screenshots in an object bucket. When unset,
#   images are stored cleanly in the HelpImage binary table (BYTEA) in Postgres.
# HELP_STORAGE_BUCKET: Supabase Storage bucket name (default: "help-centre-images").
HELP_ADMIN_EMAILS=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
HELP_STORAGE_BUCKET="help-centre-images"


