# Copy to .env.local for development. Never commit real secrets.
#
# VERCEL / PRODUCTION (Supabase):
#   DATABASE_URL = the Supavisor TRANSACTION POOLER connection string
#   (Supabase Dashboard → Project Settings → Database → Connection string →
#   "Transaction pooler", port 6543, ends with ?pgbouncer=true). Example shape:
#   postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Do NOT use the direct db.<ref>.supabase.co:5432 URL here — serverless
#   functions on Vercel usually can't reach it (Prisma P1001).
#
# MIGRATIONS / SEED from your own machine use the DIRECT (port 5432) URL:
#   DATABASE_URL="postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres" npm run prisma:deploy
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
